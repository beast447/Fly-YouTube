{
  "name": "fly-youtube",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fly routes created by MSFS YouTube flying influencers. Built on the Fly YouTube Design System.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/src/server.js",
    "server:dev": "node --watch server/src/server.js",
    "db:migrate": "node server/src/db/migrate.js",
    "db:seed": "node server/src/db/seed.js",
    "dev:full": "concurrently \"npm run server:dev\" \"npm run dev\"",
    "test:backend": "node --test server/tests/*.test.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "concurrently": "^9.2.1"
  }
}
